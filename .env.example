# ─── Supabase ───────────────────────────────────────────────
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Client-facing Supabase variables (Vite build-time replacement)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ─── GitHub OAuth ───────────────────────────────────────────
GITHUB_CLIENT_ID="your-github-oauth-app-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-app-client-secret"

# Encryption key for GitHub connection tokens (base64-encoded 32-byte key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_USER_CONNECTION_KEY_SECRET="your-base64-32-byte-secret"

# ─── AI Provider (pick one) ────────────────────────────────
# Provider: "openai" | "anthropic" | "google"
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# GOOGLE_GENERATIVE_AI_API_KEY="..."

# Optional AI overrides
# AI_MODEL="gpt-4o"
# AI_TIMEOUT_MS="60000"
# AI_MAX_TOKENS="4096"

# ─── Cron Auth ──────────────────────────────────────────────
CRON_SECRET="your-cron-secret"
# CRON_SECRET_PREVIOUS="old-cron-secret-during-rotation"

# ─── Error Tracking (optional) ─────────────────────────────
# VITE_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
