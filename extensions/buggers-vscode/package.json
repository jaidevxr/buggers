{
  "name": "buggers-vscode",
  "displayName": "Buggers",
  "description": "Continuous Code Security, Automated SAST Flaw Detection, Inline Code Highlighting & Safe Fixes",
  "version": "1.4.7",
  "publisher": "buggers",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "resources/icon.png",
  "homepage": "https://buggers.dev",
  "bugs": {
    "url": "https://github.com/jaidevxr/buggers/issues"
  },
  "qna": "marketplace",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaidevxr/buggers.git",
    "directory": "extensions/buggers-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "pricing": "Free",
  "galleryBanner": {
    "color": "#09090b",
    "theme": "dark"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other",
    "Testing"
  ],
  "keywords": [
    "buggers",
    "security",
    "sast",
    "code review",
    "pull request",
    "vulnerability scanner",
    "secret scanning",
    "owasp",
    "devsecops",
    "code security"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:buggers.findingsView",
    "onView:buggers.inspectorView",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:go",
    "onLanguage:sql",
    "onLanguage:shellscript",
    "workspaceContains:**/*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "buggers.signIn",
        "title": "Buggers: Sign In",
        "category": "Buggers"
      },
      {
        "command": "buggers.signOut",
        "title": "Buggers: Sign Out",
        "category": "Buggers"
      },
      {
        "command": "buggers.analyzeFile",
        "title": "Buggers: Analyze Current File",
        "category": "Buggers"
      },
      {
        "command": "buggers.analyzeWorkspace",
        "title": "Buggers: Analyze Workspace",
        "category": "Buggers"
      },
      {
        "command": "buggers.showFindings",
        "title": "Buggers: Show Findings",
        "category": "Buggers"
      },
      {
        "command": "buggers.refreshFindings",
        "title": "Buggers: Refresh Findings",
        "category": "Buggers"
      },
      {
        "command": "buggers.clearFindings",
        "title": "Buggers: Clear Findings",
        "category": "Buggers"
      },
      {
        "command": "buggers.openDashboard",
        "title": "Buggers: Open Buggers Dashboard",
        "category": "Buggers"
      },
      {
        "command": "buggers.applyRemedy",
        "title": "Buggers: Fix Finding (Apply Directly)",
        "category": "Buggers",
        "icon": "$(tools)"
      },
      {
        "command": "buggers.commitRemedy",
        "title": "Buggers: Commit Security Remedy",
        "category": "Buggers",
        "icon": "$(git-commit)"
      },
      {
        "command": "buggers.inspectFinding",
        "title": "Buggers: Inspect Finding & Auto-Remedy",
        "category": "Buggers",
        "icon": "$(eye)"
      },
      {
        "command": "buggers.openInspector",
        "title": "Buggers: Open Finding Details & Actions",
        "category": "Buggers",
        "icon": "$(shield)"
      },
      {
        "command": "buggers.previewDiff",
        "title": "Buggers: Preview Fix Diff",
        "category": "Buggers",
        "icon": "$(diff)"
      },
      {
        "command": "buggers.fixAllFile",
        "title": "Buggers: Fix All Flaws in Active File",
        "category": "Buggers",
        "icon": "$(wand)"
      },
      {
        "command": "buggers.fixAllWorkspace",
        "title": "Buggers: Fix All Flaws in Workspace",
        "category": "Buggers",
        "icon": "$(zap)"
      },
      {
        "command": "buggers.ignoreFinding",
        "title": "Buggers: Suppress Finding (Insert Ignore Comment)",
        "category": "Buggers",
        "icon": "$(bell-slash)"
      },
      {
        "command": "buggers.generateSecurityReport",
        "title": "Buggers: Generate Workspace Security Audit Report",
        "category": "Buggers",
        "icon": "$(output)"
      },
      {
        "command": "buggers.installGitHook",
        "title": "Buggers: Install Security Pre-Commit Git Hook",
        "category": "Buggers",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "buggers.explainFinding",
        "title": "Buggers: Explain Finding & Rule Guidance",
        "category": "Buggers",
        "icon": "$(book)"
      },
      {
        "command": "buggers.suggestFix",
        "title": "Buggers: Fix Finding",
        "category": "Buggers",
        "icon": "$(tools)"
      },
      {
        "command": "buggers.generateRegressionTest",
        "title": "Buggers: Generate Regression Test",
        "category": "Buggers",
        "icon": "$(beaker)"
      },
      {
        "command": "buggers.findLogicalBugs",
        "title": "Buggers: Scan for Logical Bugs",
        "category": "Buggers",
        "icon": "$(check-all)"
      },
      {
        "command": "buggers.toggleGrouping",
        "title": "Buggers: Toggle Findings Grouping Mode",
        "category": "Buggers",
        "icon": "$(list-tree)"
      },
      {
        "command": "buggers.filterFindings",
        "title": "Buggers: Filter Findings by Severity",
        "category": "Buggers",
        "icon": "$(filter)"
      },
      {
        "command": "buggers.exportFindings",
        "title": "Buggers: Export Findings to SARIF or JSON",
        "category": "Buggers",
        "icon": "$(export)"
      },
      {
        "command": "buggers.copyPatch",
        "title": "Buggers: Copy Remediation Patch",
        "category": "Buggers",
        "icon": "$(copy)"
      },
      {
        "command": "buggers.dismissFinding",
        "title": "Buggers: Dismiss Finding from Display",
        "category": "Buggers",
        "icon": "$(eye-closed)"
      },
      {
        "command": "buggers.moreActions",
        "title": "Buggers: More Actions for Finding",
        "category": "Buggers",
        "icon": "$(ellipsis)"
      },
      {
        "command": "buggers.selectFinding",
        "title": "Buggers: Select Finding & Highlight Code",
        "category": "Buggers",
        "icon": "$(go-to-file)"
      },
      {
        "command": "buggers.gitReviewChanges",
        "title": "Buggers: Review Changed Files & Pre-Commit Audit",
        "category": "Buggers",
        "icon": "$(git-compare)"
      },
      {
        "command": "buggers.gitCommit",
        "title": "Buggers: Commit Approved Changes to GitHub",
        "category": "Buggers",
        "icon": "$(git-commit)"
      },
      {
        "command": "buggers.gitPush",
        "title": "Buggers: Push Approved Commits to GitHub",
        "category": "Buggers",
        "icon": "$(repo-push)"
      },
      {
        "command": "buggers.openOnGitHub",
        "title": "Buggers: Open Repository on GitHub",
        "category": "Buggers",
        "icon": "$(link-external)"
      },
      {
        "command": "buggers.connectGitHub",
        "title": "Buggers: Connect GitHub Account",
        "category": "Buggers",
        "icon": "$(key)"
      },
      {
        "command": "buggers.refreshGitHubStatus",
        "title": "Buggers: Refresh GitHub Repository Status",
        "category": "Buggers",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "buggers.analyzeWorkspace",
          "when": "view == buggers.findingsView",
          "group": "navigation@1"
        },
        {
          "command": "buggers.analyzeFile",
          "when": "view == buggers.findingsView",
          "group": "navigation@2"
        },
        {
          "command": "buggers.refreshFindings",
          "when": "view == buggers.findingsView",
          "group": "navigation@3"
        },
        {
          "command": "buggers.clearFindings",
          "when": "view == buggers.findingsView",
          "group": "navigation@4"
        },
        {
          "command": "buggers.filterFindings",
          "when": "view == buggers.findingsView",
          "group": "navigation@5"
        },
        {
          "command": "buggers.toggleGrouping",
          "when": "view == buggers.findingsView",
          "group": "navigation@6"
        },
        {
          "command": "buggers.exportFindings",
          "when": "view == buggers.findingsView",
          "group": "navigation@7"
        },
        {
          "command": "buggers.gitReviewChanges",
          "when": "view == buggers.findingsView && buggers.isGitHubRepo == true",
          "group": "navigation@8"
        },
        {
          "command": "buggers.gitCommit",
          "when": "view == buggers.findingsView && buggers.isGitHubRepo == true",
          "group": "navigation@9"
        },
        {
          "command": "buggers.gitPush",
          "when": "view == buggers.findingsView && buggers.isGitHubRepo == true",
          "group": "navigation@10"
        }
      ],
      "view/item/context": [
        {
          "command": "buggers.applyRemedy",
          "when": "view == buggers.findingsView && viewItem == findingWithFix",
          "group": "inline@1"
        },
        {
          "command": "buggers.previewDiff",
          "when": "view == buggers.findingsView && viewItem == findingWithFix",
          "group": "inline@2"
        },
        {
          "command": "buggers.explainFinding",
          "when": "view == buggers.findingsView && (viewItem == findingWithFix || viewItem == findingNoFix)",
          "group": "inline@3"
        },
        {
          "command": "buggers.moreActions",
          "when": "view == buggers.findingsView && (viewItem == findingWithFix || viewItem == findingNoFix)",
          "group": "inline@4"
        },
        {
          "command": "buggers.applyRemedy",
          "when": "view == buggers.findingsView && viewItem == findingWithFix",
          "group": "1_actions@1"
        },
        {
          "command": "buggers.previewDiff",
          "when": "view == buggers.findingsView && viewItem == findingWithFix",
          "group": "1_actions@2"
        },
        {
          "command": "buggers.copyPatch",
          "when": "view == buggers.findingsView && viewItem == findingWithFix",
          "group": "1_actions@3"
        },
        {
          "command": "buggers.explainFinding",
          "when": "view == buggers.findingsView",
          "group": "1_actions@4"
        },
        {
          "command": "buggers.generateRegressionTest",
          "when": "view == buggers.findingsView",
          "group": "1_actions@5"
        },
        {
          "command": "buggers.ignoreFinding",
          "when": "view == buggers.findingsView",
          "group": "1_actions@6"
        },
        {
          "command": "buggers.dismissFinding",
          "when": "view == buggers.findingsView",
          "group": "1_actions@7"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "buggers-sidebar",
          "title": "Buggers",
          "icon": "resources/bugmark.svg"
        }
      ]
    },
    "views": {
      "buggers-sidebar": [
        {
          "id": "buggers.findingsView",
          "name": "Security & Triage Findings"
        },
        {
          "id": "buggers.inspectorView",
          "name": "Finding Details & Actions",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Buggers",
      "properties": {
        "buggers.serverUrl": {
          "type": "string",
          "default": "https://buggers.dev",
          "description": "Buggers dashboard and API server endpoint URL"
        },
        "buggers.autoAnalyzeOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run SAST and secret analysis whenever an active file is saved"
        },
        "buggers.minimumSeverity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "default": "low",
          "description": "Minimum vulnerability severity displayed in the VS Code Problems panel"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "build": "node esbuild.js",
    "package": "npx @vscode/vsce package --no-dependencies",
    "test": "node test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
