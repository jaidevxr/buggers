{
  "name": "buggers-vscode",
  "displayName": "Buggers",
  "description": "Automated Pull Request Code Review, OWASP SAST Flaw Detection & Bug Triage",
  "version": "1.2.0",
  "publisher": "buggers",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "resources/icon.png",
  "homepage": "https://buggers.dev",
  "bugs": {
    "url": "https://github.com/jaidevxr/buggers/issues"
  },
  "qna": "marketplace",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaidevxr/buggers.git",
    "directory": "extensions/buggers-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "pricing": "Free",
  "galleryBanner": {
    "color": "#09090b",
    "theme": "dark"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other",
    "Testing"
  ],
  "keywords": [
    "buggers",
    "security",
    "sast",
    "code review",
    "pull request",
    "vulnerability scanner",
    "secret scanning",
    "owasp",
    "devsecops",
    "code security"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "buggers.signIn",
        "title": "Buggers: Sign In",
        "category": "Buggers"
      },
      {
        "command": "buggers.signOut",
        "title": "Buggers: Sign Out",
        "category": "Buggers"
      },
      {
        "command": "buggers.analyzeFile",
        "title": "Buggers: Analyze Current File",
        "category": "Buggers"
      },
      {
        "command": "buggers.analyzeWorkspace",
        "title": "Buggers: Analyze Workspace",
        "category": "Buggers"
      },
      {
        "command": "buggers.showFindings",
        "title": "Buggers: Show Findings",
        "category": "Buggers"
      },
      {
        "command": "buggers.refreshFindings",
        "title": "Buggers: Refresh Findings",
        "category": "Buggers"
      },
      {
        "command": "buggers.clearFindings",
        "title": "Buggers: Clear Findings",
        "category": "Buggers"
      },
      {
        "command": "buggers.openDashboard",
        "title": "Buggers: Open Buggers Dashboard",
        "category": "Buggers"
      },
      {
        "command": "buggers.applyRemedy",
        "title": "Buggers: Apply Automated Remedy",
        "category": "Buggers",
        "icon": "$(tools)"
      },
      {
        "command": "buggers.commitRemedy",
        "title": "Buggers: Commit Security Remedy",
        "category": "Buggers",
        "icon": "$(git-commit)"
      },
      {
        "command": "buggers.inspectFinding",
        "title": "Buggers: Inspect Finding & Auto-Remedy",
        "category": "Buggers",
        "icon": "$(eye)"
      },
      {
        "command": "buggers.openInspector",
        "title": "Buggers: Open Flaw Inspector & Exploit Details",
        "category": "Buggers",
        "icon": "$(shield)"
      },
      {
        "command": "buggers.previewDiff",
        "title": "Buggers: Preview Security Remedy Diff",
        "category": "Buggers",
        "icon": "$(diff)"
      },
      {
        "command": "buggers.fixAllFile",
        "title": "Buggers: Fix All Flaws in Active File",
        "category": "Buggers",
        "icon": "$(wand)"
      },
      {
        "command": "buggers.fixAllWorkspace",
        "title": "Buggers: Fix All Flaws in Workspace",
        "category": "Buggers",
        "icon": "$(zap)"
      },
      {
        "command": "buggers.ignoreFinding",
        "title": "Buggers: Suppress Finding (Insert Ignore Comment)",
        "category": "Buggers",
        "icon": "$(bell-slash)"
      },
      {
        "command": "buggers.generateSecurityReport",
        "title": "Buggers: Generate Workspace Security Audit Report",
        "category": "Buggers",
        "icon": "$(output)"
      },
      {
        "command": "buggers.installGitHook",
        "title": "Buggers: Install Security Pre-Commit Git Hook",
        "category": "Buggers",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "buggers.explainFinding",
        "title": "Buggers: Explain Finding & Root Cause",
        "category": "Buggers",
        "icon": "$(book)"
      },
      {
        "command": "buggers.suggestFix",
        "title": "Buggers: Review Fix Diff & Apply",
        "category": "Buggers",
        "icon": "$(tools)"
      },
      {
        "command": "buggers.debugSelection",
        "title": "Buggers: Debug Selected Code with AI",
        "category": "Buggers",
        "icon": "$(debug-alt)"
      },
      {
        "command": "buggers.generateRegressionTest",
        "title": "Buggers: Generate Regression Test",
        "category": "Buggers",
        "icon": "$(beaker)"
      },
      {
        "command": "buggers.findLogicalBugs",
        "title": "Buggers: Scan for Logical Bugs",
        "category": "Buggers",
        "icon": "$(check-all)"
      },
      {
        "command": "buggers.configureAiProvider",
        "title": "Buggers: Configure AI Provider",
        "category": "Buggers",
        "icon": "$(gear)"
      },
      {
        "command": "buggers.clearAiCredentials",
        "title": "Buggers: Clear Stored AI Credentials",
        "category": "Buggers",
        "icon": "$(key)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "buggers.analyzeWorkspace",
          "when": "view == buggers.findingsView",
          "group": "navigation@1"
        },
        {
          "command": "buggers.fixAllFile",
          "when": "view == buggers.findingsView",
          "group": "navigation@2"
        },
        {
          "command": "buggers.generateSecurityReport",
          "when": "view == buggers.findingsView",
          "group": "navigation@3"
        },
        {
          "command": "buggers.refreshFindings",
          "when": "view == buggers.findingsView",
          "group": "navigation@4"
        },
        {
          "command": "buggers.clearFindings",
          "when": "view == buggers.findingsView",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "buggers.applyRemedy",
          "when": "view == buggers.findingsView && viewItem == findingWithFix",
          "group": "inline@1"
        },
        {
          "command": "buggers.commitRemedy",
          "when": "view == buggers.findingsView && viewItem == findingWithFix",
          "group": "inline@2"
        },
        {
          "command": "buggers.openInspector",
          "when": "view == buggers.findingsView",
          "group": "1_actions@1"
        },
        {
          "command": "buggers.previewDiff",
          "when": "view == buggers.findingsView && viewItem == findingWithFix",
          "group": "1_actions@2"
        },
        {
          "command": "buggers.applyRemedy",
          "when": "view == buggers.findingsView && viewItem == findingWithFix",
          "group": "1_actions@3"
        },
        {
          "command": "buggers.commitRemedy",
          "when": "view == buggers.findingsView && viewItem == findingWithFix",
          "group": "1_actions@4"
        },
        {
          "command": "buggers.ignoreFinding",
          "when": "view == buggers.findingsView",
          "group": "1_actions@5"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "buggers-sidebar",
          "title": "Buggers",
          "icon": "resources/bugmark.svg"
        }
      ]
    },
    "views": {
      "buggers-sidebar": [
        {
          "id": "buggers.findingsView",
          "name": "Security & Triage Findings"
        }
      ]
    },
    "configuration": {
      "title": "Buggers",
      "properties": {
        "buggers.serverUrl": {
          "type": "string",
          "default": "https://buggers.dev",
          "description": "Buggers dashboard and API server endpoint URL"
        },
        "buggers.autoAnalyzeOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run SAST and secret analysis whenever an active file is saved"
        },
        "buggers.minimumSeverity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "default": "low",
          "description": "Minimum vulnerability severity displayed in the VS Code Problems panel"
        },
        "buggers.ai.provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "gemini",
            "ollama",
            "custom"
          ],
          "default": "openai",
          "description": "AI provider for automated bug explanation, diff generation, and test generation"
        },
        "buggers.ai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model identifier used for AI debugging and explanation requests"
        },
        "buggers.ai.customEndpoint": {
          "type": "string",
          "default": "",
          "description": "Custom endpoint URL for local or self-hosted LLM services (e.g., http://localhost:11434)"
        },
        "buggers.ai.timeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "Maximum timeout in milliseconds for AI requests"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "build": "node esbuild.js",
    "package": "npx @vscode/vsce package --no-dependencies",
    "test": "node test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
